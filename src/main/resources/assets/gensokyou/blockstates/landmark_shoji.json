{
  "multipart": [
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_post"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_noside_alt"
      },
      "when": {
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_noside_alt",
        "y": 90
      },
      "when": {
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "gensokyou:block/landmark_shoji_noside",
        "y": 270
      },
      "when": {
        "west": "false"
      }
    }
  ]
}
