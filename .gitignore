=======
.gradle
gradle.properties
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# gen_tex.py previews
tools/textures/_preview/
__pycache__/
.cocoindex_code/
.codex
# CocoIndex Code (ccc)
/.cocoindex_code/

# Dedicated server install for the jar-server toolchain (~176MB, do not track)
server/

# Performance profiling dumps (JFR records environment variables; keep local only)
*.jfr
logs/wall*
